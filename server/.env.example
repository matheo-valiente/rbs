# Copier ce fichier en `.env` et remplir avec les vraies clés Stripe
# (Dashboard Stripe > Développeurs > Clés API)

PORT=3001

# Clé secrète Stripe (sk_test_... en test, sk_live_... en prod)
STRIPE_SECRET_KEY=sk_test_xxx

# Secret de signature du webhook (Dashboard Stripe > Webhooks > votre endpoint > Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# URL publique du frontend (utilisée pour les redirections après paiement)
CLIENT_URL=http://localhost:5173
