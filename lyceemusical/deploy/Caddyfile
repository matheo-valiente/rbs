# HTTPS automatique (Let's Encrypt) pour le domaine défini par DOMAIN dans
# backend/.env, + redirection www → domaine principal.
# Prérequis : enregistrements DNS A de DOMAIN et www.DOMAIN → IP du VPS.

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy app:3001
}
