# Copier en `.env` et remplir. Ne JAMAIS commiter le vrai .env.

PORT=3001

# Nom de domaine (HTTPS automatique) et URL publique — à changer ensemble
DOMAIN=lyceemusical.com
# dev : http://localhost:5173  —  prod : https://lyceemusical.com
PUBLIC_URL=http://localhost:5173

# ---------------------------------------------------------------
# STRIPE (Dashboard Stripe > Développeurs > Clés API)
# sk_test_... pour tester, sk_live_... le jour J
# ---------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
# Dashboard > Développeurs > Webhooks > ton endpoint > "Signing secret"
# (en local : affiché par `stripe listen --forward-to localhost:3001/api/webhook`)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# TVA : 20 si RBS SAS est assujettie (prix TTC inchangés, TVA détaillée sur
# les factures), 0 si franchise en base. Puis `npm run stripe:setup` qui crée
# le taux et affiche STRIPE_TAX_RATE_ID (+ le webhook en prod).
VAT_RATE=20
STRIPE_TAX_RATE_ID=
# Facture PDF numérotée au nom de RBS SAS pour chaque commande (envoyée au client)
STRIPE_INVOICES=true
# Relevé bancaire du client : « RBS* LYCEE MUSICAL » (22 caractères max au total)
STATEMENT_DESCRIPTOR_SUFFIX=LYCEE MUSICAL
# Logo affiché sur la page de paiement Stripe (URL https publique, PNG/JPG)
# ex. https://lyceemusical.com/media/logo.png — vide = nom « Lycée Musical — Luvbfk »
CHECKOUT_LOGO_URL=

# ---------------------------------------------------------------
# PRÉCOMMANDE — dates au format ISO avec fuseau (heure de Paris)
# Attention : passage à l'heure d'hiver le 25/10/2026 (+02:00 -> +01:00)
# ---------------------------------------------------------------
PREORDER_OPENS_AT=2026-10-15T00:00:00+02:00
PREORDER_CLOSES_AT=2026-10-28T23:59:59+01:00
# Texte affiché sur le site + dans les emails
SHIPPING_ESTIMATE=Expédition prévue à partir du [DATE À COMPLÉTER]

# Max par personne (par adresse email, toutes commandes confondues)
MAX_CD_PER_PERSON=3
MAX_TSHIRT_PER_PERSON=3

# ---------------------------------------------------------------
# LIVRAISON
# ---------------------------------------------------------------
# Frais de port en centimes (0 = livraison offerte)
SHIPPING_FEE_CENTS=500
# Pays autorisés (codes ISO séparés par des virgules)
SHIPPING_COUNTRIES=FR,BE,CH,LU,MC

# ---------------------------------------------------------------
# NOTIFICATIONS COMMANDE
# ---------------------------------------------------------------
# Emails des 2 responsables (séparés par des virgules)
NOTIFY_EMAILS=responsable1@exemple.com,responsable2@exemple.com

# SMTP (Brevo, Resend, OVH Mail Pro, Gmail + mot de passe d'application…)
# Exemple Brevo : smtp-relay.brevo.com / 587 / login Brevo / clé SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Expéditeur (doit être un domaine vérifié chez le fournisseur SMTP)
MAIL_FROM="Lycée Musical <commandes@lyceemusical.com>"
# Adresse de réponse pour les clients
MAIL_REPLY_TO=contact@lyceemusical.com
# Envoyer aussi un email de confirmation au client (true/false)
SEND_CUSTOMER_EMAIL=true

# Optionnel : notification Telegram instantanée (groupe des 2 responsables)
# 1. créer un bot avec @BotFather -> token
# 2. ajouter le bot dans un groupe, récupérer le chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------
# ADMIN (page /admin : liste des commandes, export CSV, suivi expédition)
# Mot de passe long et aléatoire : `openssl rand -base64 24`
# ---------------------------------------------------------------
ADMIN_PASSWORD=change-moi

# Base SQLite (en Docker : /app/data/shop.db, monté sur ./data)
DB_PATH=../data/shop.db
